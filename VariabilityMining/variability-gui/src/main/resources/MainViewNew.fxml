<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="at.variabilityanalysisgui.controller.Controller">
    <right>
        <ScrollPane fx:id="detailScrollPane" fitToWidth="true" managed="false" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefWidth="400.0" visible="false">
            <VBox fx:id="detailsPane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" spacing="10" style="-fx-padding: 10;">
                <Label maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="Details" />
                <HBox fx:id="detailsNameHBox" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="30.0" prefWidth="200.0">
                    <children>
                        <Label fx:id="detailGroupNameLabel" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="Name: " wrapText="true" />
                        <TextField fx:id="detailGroupNameTextField" />
                        <Button fx:id="detailChangeNameButton" mnemonicParsing="false" text="Change Name" />
                    </children>
                </HBox>
                <HBox fx:id="detailNamingHistoryHBox" prefHeight="30.0" prefWidth="200.0">
                    <children>
                        <Label fx:id="detailNamingHistoryLabel" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-font-weight: bold;" text="Naming-History" />
                        <Button fx:id="detailChangeBackButton" mnemonicParsing="false" text="Change Back">
                            <HBox.margin>
                                <Insets left="7.0" top="2.0" />
                            </HBox.margin>
                        </Button>
                    </children>
                </HBox>
                <ListView fx:id="detailNamingHistoryListView" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="100.0" />
                <Label fx:id="detailDescriptionLabel" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-font-weight: bold;" text="Description" />
                <TextArea fx:id="detailDescription" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="150.0" prefWidth="200.0" wrapText="true"/>
                <Label fx:id="detailLocationLabel" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-font-weight: bold;" text="Location" />
                <TextArea fx:id="detailLocationTextArea" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="50.0" prefWidth="200.0" />
                <Label fx:id="detailOccurrenceLabel" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-font-weight: bold;" text="Occurrences" />
                <ListView fx:id="detailOccurrencesListView" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="100.0" />
                <Label fx:id="detailElementLabel" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-font-weight: bold;" text="Element" />
                <TextArea fx:id="detailElementData" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="100.0" prefWidth="200.0" />
                <Label fx:id="detailSubElementLabel" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-font-weight: bold;" text="Subelements" />
                <ListView fx:id="detailSubElementListView" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="200" />
                <Button fx:id="detailCloseButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" text="Close Details" />
            </VBox>
        </ScrollPane>
    </right>
    <top>
        <MenuBar maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefWidth="808.0" BorderPane.alignment="CENTER">
            <menus>
                <Menu text="File">
                    <items>
                        <MenuItem fx:id="loadItem" onAction="#handleLoadAction" text="Load" />
                        <MenuItem fx:id="saveItem" onAction="#handleSaveAction" text="Save" />
                        <SeparatorMenuItem />
                        <MenuItem onAction="#handleExit" text="Exit" />
                    </items>
                </Menu>
            </menus>
            <BorderPane.margin>
                <Insets bottom="5.0" />
            </BorderPane.margin>
        </MenuBar>
    </top>
   <center>
      <SplitPane fx:id="mainSplitPane" dividerPositions="0.5" prefHeight="30.0" BorderPane.alignment="CENTER" VBox.vgrow="ALWAYS">
        <items>
          <AnchorPane minHeight="10.0" minWidth="10.0" prefHeight="160.0" prefWidth="400.0">
               <children>
                  <TabPane fx:id="varflixTabPane" prefHeight="200.0" prefWidth="200.0" tabClosingPolicy="UNAVAILABLE" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <tabs>
                      <Tab closable="false" text="Feature View">
                      	<content>
                      		<fx:include fx:id="featureView" source="FeatureViewTab.fxml" />
                      	</content>
                      </Tab>
                      <Tab fx:id="constraintsTab" closable="false" text="Constraints View">
                      	<content>
                      		<fx:include fx:id="constraintsView" source="ConstraintsViewTab.fxml" />
                      	</content>
                      </Tab>
                    </tabs>
                  </TabPane>
               </children>
            </AnchorPane>
          <AnchorPane minHeight="10.0" minWidth="10.0" prefHeight="160.0" prefWidth="400.0">
               <children>
                      <ScrollPane fx:id="visualizationWindow" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
               </children>
            </AnchorPane>
        </items>
      </SplitPane>
   </center>

</BorderPane>
